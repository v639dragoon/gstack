#!/usr/bin/env bash
# gstack-context-fence — Claude Code PreToolUse hook: past the context handoff
# threshold, refuse a NEW expensive dispatch until a checkpoint exists.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval "$("$SCRIPT_DIR/gstack-paths")" || exit 1; : "${GSTACK_STATE_ROOT:?gstack-paths failed; reinstall with ./setup or /gstack-upgrade}"
bun "$SCRIPT_DIR/gstack-context-fence.ts"
exit 0
