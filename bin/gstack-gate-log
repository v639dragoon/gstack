#!/usr/bin/env bash
GSTACK_BUN_CONFIG=/dev/null; case "${OSTYPE:-}" in msys*|cygwin*) if command -v cygpath >/dev/null 2>&1; then GSTACK_BUN_CONFIG=NUL; fi ;; esac
# gstack-gate-log — atomically log ONE gate invocation (Phase 0 PR-gating telemetry)
# Usage: gstack-gate-log '{"record_type":"gate","gate":"specialist:security","run_id":"...",...}'
#
# Writes one line per gate INVOCATION to <branch>-gates.jsonl — a SIBLING of
# <branch>-reviews.jsonl, deliberately a separate file: gstack-review-read cats
# the whole reviews file into model context on every dashboard render, and
# gstack-specialist-stats globs `*-reviews.jsonl` only, so per-invocation gate
# rows (~10-20 per ship) stay invisible to every existing reader by
# construction instead of by filtering.
#
# Validation beyond gstack-review-log's JSON check:
#   - record_type must be exactly "gate" (discriminator; keeps a copy-pasted
#     review-log call from landing here and vice versa)
#   - gate and run_id must be non-empty strings
#   - effort_source:"user-override" REQUIRES a non-empty effort_reason — an
#     unrecorded xhigh override is the exact failure this writer exists to
#     make impossible ("prohibit implicit xhigh")
#   - effort "xhigh" or "ultra" REQUIRES effort_source:"user-override"
#     (and so a reason): effort above high is never selected automatically
#   - a Lead-ASSIGNED gpt-6-astra record (anything but gate codex-structured
#     with routed model identity) REQUIRES a non-empty model_reason: Astra replaces an existing
#     worker or reviewer only for complex state transitions, interacting
#     contracts or a demonstrated reasoning failure, and the reason is part of
#     the record (dohma ruling 2026-09-04). Routed C/D reviews carry their
#     reason in the tier and are exempt.
# Everything else passes through untouched (schema-free like review-log), so
# shadow-classifier fields ride along without writer changes.
#
# Binding fields (content-addressed staleness): every appended record is
# stamped with commit_full, tree, dirty and wtree, computed AUTHORITATIVELY
# here — caller-supplied values for the four keys are ignored. This block is
# a deliberate duplicate of bin/gstack-review-log:27-57; keep the two in sync
# (duplicated rather than shared because review-log is load-bearing for 12+
# call sites and 4 consumers, and this file must be safe to evolve alone).
# Same known limitation as review-log: binding happens at LOG time, not
# gate-START time; the started_at/ended_at fields inside the record are the
# caller's own clock and are NOT certified by the stamp.
#
# Derived/defaulted fields (only when the caller OMITS the key; an explicit
# caller value always wins, so this is backward-compatible with every existing
# call site and record):
#   - commit        <- git rev-parse --short HEAD. Pure redundancy with the
#                      authoritative commit_full stamped above, and every call
#                      site was hand-substituting it from the same HEAD.
#   - diff_scope    <- "full"   (every Phase 0 gate reviews the full diff)
#   - critical_path <- true     (every Phase 0 gate blocks the ship)
# manifest_wtree is deliberately NOT derived: it records the worktree the
# MANIFEST was built in, and the log-time worktree is already stamped as
# `wtree`. Deriving it would make the two always agree and destroy the only
# signal that a manifest came from a different tree than the gate it logs.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval "$("$SCRIPT_DIR/gstack-paths")" || exit 1; : "${GSTACK_STATE_ROOT:?gstack-paths failed; reinstall with ./setup or /gstack-upgrade}"
# Only the repository slug is needed (project markers never route gate rows).
# Match gstack-slug's branch spelling without a second full slug resolution.
RAW_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || RAW_BRANCH=""
BRANCH=$(printf '%s' "$RAW_BRANCH" | tr '/' '-' | tr -cd 'a-zA-Z0-9._-')
BRANCH="${BRANCH:-unknown}"
# A private effort receipt's sibling can carry identity to the terminal voice
# row in the SAME dispatch. Bind it to cwd, state root, branch, explicit slug
# and remote routing; a stale handoff falls back to normal derivation.
CONTEXT_IN=""; CONTEXT_OUT=""
case "${2:-}" in
  --context-in) CONTEXT_IN="${3:-}" ;;
  --context-out) CONTEXT_OUT="${3:-}" ;;
esac
CONTEXT_CWD=$(pwd -P)
CONTEXT_ROUTING=$(git config --get-regexp '^(remote\..*\.url|branch\..*\.(remote|merge))$' 2>/dev/null || true)
SLUG=""
if [ -n "$CONTEXT_IN" ]; then
  SLUG=$(GSTACK_GATE_CONTEXT="$CONTEXT_IN" GSTACK_GATE_ROOT="$GSTACK_STATE_ROOT" GSTACK_GATE_CWD="$CONTEXT_CWD" GSTACK_GATE_BRANCH="$BRANCH" GSTACK_GATE_ROUTING="$CONTEXT_ROUTING" bun --no-env-file --config="${GSTACK_BUN_CONFIG:-/dev/null}" -e '
    try {
      const c=JSON.parse(process.env.GSTACK_GATE_CONTEXT), e=process.env;
      if(c.root===e.GSTACK_GATE_ROOT && c.cwd===e.GSTACK_GATE_CWD && c.branch===e.GSTACK_GATE_BRANCH && c.routing===e.GSTACK_GATE_ROUTING && c.override===(e.GSTACK_PROJECT_SLUG||"") && /^[a-zA-Z0-9._-]+$/.test(c.slug) && ![".",".."].includes(c.slug)) process.stdout.write(c.slug);
    } catch {}' 2>/dev/null || true)
fi
SLUG_PENDING=0
if [ -z "$SLUG" ]; then
  # Identity and content stamps are independent. Resolve identity beside the
  # git reads, retaining the helper's status without a shared temporary file.
  exec 3< <("$SCRIPT_DIR/gstack-slug" --get REPO_SLUG; printf '%s\n' "$?")
  SLUG_PENDING=1
fi

INPUT="$1"

# Governor identity stamps. These are authoritative just like commit/tree:
# caller-supplied values are discarded. Missing metadata is stamped as null.
# The TS entrypoint already accepts the wrapper's resolved context. Pass only
# values derived here, in this process tree and cwd; do not accept an inherited
# slug/project-dir shortcut that could redirect a standalone gate-log call.
# Outcome config keys use the RAW branch, unlike the sanitized JSONL filename.
OUTCOME_BRANCH=$(git branch --show-current 2>/dev/null || printf '%s' "$BRANCH")
MANIFEST_WTREE=$(printf '%s' "$INPUT" | bun --no-env-file --config="${GSTACK_BUN_CONFIG:-/dev/null}" -e 'try { const r=JSON.parse(await Bun.stdin.text()); if(typeof r.manifest_wtree==="string") process.stdout.write(r.manifest_wtree) } catch {}' 2>/dev/null || true)

# Compute binding fields (best-effort; empty outside a git repo).
HEAD_EXISTS=1
COMMIT_FULL=$(git rev-parse HEAD 2>/dev/null) || HEAD_EXISTS=0
TREE=""
COMMIT_SHORT=""
WTREE=""
DIRTY=""
if [ -n "$COMMIT_FULL" ]; then
  TREE=$(git rev-parse 'HEAD^{tree}' 2>/dev/null || true)
  COMMIT_SHORT=$(git rev-parse --short HEAD 2>/dev/null || true)
  # With neither HEAD nor an index, wtree necessarily fails at read-tree HEAD.
  # Keep all historical stamp bytes (including rev-parse's failure stdout),
  # but avoid launching that redundant failed derivation in an unborn repo.
  if [ "$HEAD_EXISTS" = 0 ] && [ ! -f "$(git rev-parse --git-path index 2>/dev/null)" ]; then
    WTREE=""
  else
    WTREE=$("$SCRIPT_DIR/gstack-wtree" 2>/dev/null || true)
  fi
  if [ -n "$(git status --porcelain -uno 2>/dev/null | head -1)" ]; then
    DIRTY="true"
  else
    DIRTY="false"
  fi
fi

if [ "$SLUG_PENDING" = 1 ]; then
  IFS= read -r SLUG <&3 || exit 1
  IFS= read -r SLUG_STATUS <&3 || exit 1
  exec 3<&-
  [ "$SLUG_STATUS" = 0 ] || exit 1
fi
mkdir -p "$GSTACK_STATE_ROOT/projects/$SLUG"
MANIFEST_FILE=""
if [ -n "$MANIFEST_WTREE" ]; then
  MANIFEST_FILE="$GSTACK_STATE_ROOT/projects/$SLUG/manifests/${MANIFEST_WTREE:0:12}.json"
fi

# Validate (reject malformed input, missing gate identity, or an unrecorded
# effort override) AND stamp in one pass. Caller values for the binding keys
# are dropped before stamping.
STAMPED=$(printf '%s' "$INPUT" | GSTACK_STAMP_COMMIT_FULL="$COMMIT_FULL" GSTACK_STAMP_TREE="$TREE" GSTACK_STAMP_WTREE="$WTREE" GSTACK_STAMP_DIRTY="$DIRTY" GSTACK_STAMP_COMMIT_SHORT="$COMMIT_SHORT" GSTACK_OUTCOME_MODULE="$SCRIPT_DIR/gstack-outcome.ts" GSTACK_OUTCOME_BRANCH="$OUTCOME_BRANCH" GSTACK_STAMP_MANIFEST_FILE="$MANIFEST_FILE" GSTACK_GATE_CONTEXT_OUT="$CONTEXT_OUT" GSTACK_GATE_ROOT="$GSTACK_STATE_ROOT" GSTACK_GATE_CWD="$CONTEXT_CWD" GSTACK_GATE_BRANCH="$BRANCH" GSTACK_GATE_ROUTING="$CONTEXT_ROUTING" GSTACK_GATE_SLUG="$SLUG" bun --no-env-file --config="${GSTACK_BUN_CONFIG:-/dev/null}" -e "
const rec = JSON.parse(await Bun.stdin.text());
const fail = (msg) => { console.error('gstack-gate-log: ' + msg); process.exit(1); };
if (rec.record_type !== 'gate') fail('record_type must be \"gate\"');
if (typeof rec.gate !== 'string' || rec.gate.length === 0) fail('missing required field: gate');
if (typeof rec.run_id !== 'string' || rec.run_id.length === 0) fail('missing required field: run_id');
if (rec.effort_source === 'user-override' && !(typeof rec.effort_reason === 'string' && rec.effort_reason.trim().length > 0)) {
  fail('effort_source \"user-override\" requires a non-empty effort_reason');
}
// xhigh/ultra require a recorded override. D4 permits upstream max from the
// env/config/default carrier; an automatic policy route still cannot choose it.
if (((rec.effort === 'xhigh' || rec.effort === 'ultra') || (rec.effort === 'max' && !['default', 'env', 'config', 'request'].includes(rec.effort_source))) && rec.effort_source !== 'user-override') {
  fail('effort \"' + rec.effort + '\" requires effort_source \"user-override\" with a recorded effort_reason');
}
// gpt-6-astra outside the routed C/D review slots is a Lead assignment that
// replaces an existing worker or reviewer; the reason travels with the record
// (dohma ruling 2026-09-04). HIGH on Astra needs a specific complexity
// justification, which is the same field with more in it.
// The exemption is the ROUTED REVIEW SLOT itself (gate codex-structured with
// effort_source routed), never the label alone: a worker record that merely
// says effort_source \"routed\" still owes its reason (ship red-team, 2026-09-04).
// Upstream resolves effective effort from env/config; that must not erase the
// planned model route. Only canonical carrier sources accept the explicit slot marker.
const carrierSource = ['default', 'config', 'env', 'request', 'user-override'].includes(rec.effort_source);
const routedReviewSlot = rec.gate === 'codex-structured'
  && (rec.effort_source === 'routed' || (rec.model_routed === true && carrierSource));
// An outside voice routed by the repo POLICY (routing.models[\"outside-voice\"]) carries
// its justification in the policy entry; an env or hand-picked Astra voice still owes one.
const policyRoutedVoice = typeof rec.gate === 'string' && rec.gate.startsWith('outside-voice:') && rec.model_source === 'policy';
if (typeof rec.gate === 'string' && rec.gate.startsWith('outside-voice:')) {
  for (const k of ['purpose', 'model', 'effort', 'status']) if (typeof rec[k] !== 'string' || !rec[k]) fail('outside-voice record requires a non-empty ' + k);
  if (!['completed', 'unavailable', 'disabled', 'skipped'].includes(rec.status)) fail('outside-voice status must be completed|unavailable|disabled|skipped');
}
if (typeof rec.model === 'string' && /astra/i.test(rec.model) && !routedReviewSlot && !policyRoutedVoice
    && !(typeof rec.model_reason === 'string' && rec.model_reason.trim().length > 0)) {
  fail('model \"' + rec.model + '\" outside the routed codex-structured slot requires a non-empty model_reason');
}
for (const k of ['commit_full', 'tree', 'wtree', 'dirty', 'outcome_id', 'outcome_slice', 'risk_tier']) delete rec[k];
const env = process.env;
if (env.GSTACK_STAMP_COMMIT_FULL) rec.commit_full = env.GSTACK_STAMP_COMMIT_FULL;
if (env.GSTACK_STAMP_TREE) rec.tree = env.GSTACK_STAMP_TREE;
if (env.GSTACK_STAMP_WTREE) rec.wtree = env.GSTACK_STAMP_WTREE;
if (env.GSTACK_STAMP_DIRTY) rec.dirty = env.GSTACK_STAMP_DIRTY === 'true';
if (rec.commit === undefined && env.GSTACK_STAMP_COMMIT_SHORT) rec.commit = env.GSTACK_STAMP_COMMIT_SHORT;
if (rec.diff_scope === undefined) rec.diff_scope = 'full';
if (rec.critical_path === undefined) rec.critical_path = true;
let outcome = { present: false };
try { outcome = (await import(env.GSTACK_OUTCOME_MODULE)).readOutcome(env.GSTACK_OUTCOME_BRANCH); } catch {}
rec.outcome_id = outcome.present ? outcome.outcome_id : null;
rec.outcome_slice = outcome.present ? outcome.slice_number : null;
let riskTier = '';
try { riskTier = (await Bun.file(env.GSTACK_STAMP_MANIFEST_FILE).json()).routing?.risk_tier || ''; } catch {}
rec.risk_tier = typeof riskTier === 'string' && /^[ABCD]$/.test(riskTier) ? riskTier : null;
if (env.GSTACK_GATE_CONTEXT_OUT) {
  // Exclusive creation beside the already-exclusive private effort receipt.
  // This is internal context, never an extra field in a telemetry record.
  try { require('fs').writeFileSync(env.GSTACK_GATE_CONTEXT_OUT, JSON.stringify({root:env.GSTACK_GATE_ROOT,cwd:env.GSTACK_GATE_CWD,branch:env.GSTACK_GATE_BRANCH,routing:env.GSTACK_GATE_ROUTING,override:env.GSTACK_PROJECT_SLUG||'',slug:env.GSTACK_GATE_SLUG}), {mode:0o600,flag:'wx'}); } catch {}
}
console.log(JSON.stringify(rec));
") || {
  echo "gstack-gate-log: invalid or rejected record, skipping" >&2
  exit 1
}

echo "$STAMPED" >> "$GSTACK_STATE_ROOT/projects/$SLUG/$BRANCH-gates.jsonl"

# gbrain-sync: enqueue for cross-machine sync (no-op if sync is off).
"$SCRIPT_DIR/gstack-brain-enqueue" "projects/$SLUG/$BRANCH-gates.jsonl" 2>/dev/null &
