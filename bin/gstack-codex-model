#!/usr/bin/env bash
# gstack-codex-model — resolve the MODEL a routed Codex call runs on.
#
#   gstack-codex-model resolve --model <slug|""> --effort <medium|high> [--source policy|default]
#   gstack-codex-model resolve --voice <purpose> [--effort <low|medium|high>]
#
# `--voice <purpose>` routes an OUTSIDE VOICE (plan-review, design-review,
# design-direction, doc-release, spec, autoplan, codex-review, ...): the
# repo's .gstack-policy.json `routing.models["outside-voice"][<purpose>]`
# may name {model, effort}; GSTACK_CODEX_MODEL names a model when the policy
# does not (source env); otherwise the default route (the project's own
# .codex/config.toml) at the caller's --effort (medium when omitted). A voice
# NEVER inherits the frontier model: an unrouted voice runs the project
# default, and a policy effort above high is refused exactly like --effort.
#
# The review plan (gstack-review-budget plan, policy `routing.models`) may name
# a model for the codex-structured slot; the client default (the project's
# .codex/config.toml, then ~/.codex/config.toml) applies otherwise. This
# command decides, ONCE per dispatch, whether the named model actually runs on
# the installed CLI and the signed-in account (one minimal access check via
# _gstack_codex_model_available), and prints shell-assignable KEY=VALUE lines
# the caller carries into the codex invocation:
#
#   CODEX_MODEL_REQUESTED=<slug or default>
#   CODEX_MODEL=<slug actually used, or the resolved default's name>
#   CODEX_MODEL_SOURCE=policy|default|fallback
#   CODEX_MODEL_SUBSTITUTED=true|false
#   CODEX_MODEL_SUBSTITUTION_REASON=none|model-unavailable:<hint>|probe-inconclusive:<detail>|no-auth
#   CODEX_MODEL_EXEC_FLAGS=--model <slug>          (empty on the default route; `codex exec` form)
#   CODEX_MODEL_REVIEW_FLAGS=-c model="<slug>" -c review_model="<slug>"  (empty on the default route; `codex review` rejects -m; both keys so the routed model wins over the rendered frontier default)
#   CODEX_EFFORT=<medium|high>
#
# Contract:
#   - The model is the ONLY thing this resolves. Effort is echoed back verbatim
#     and validated: xhigh, max and ultra are refused (exit 1) because effort
#     above high is never selected automatically.
#   - Unavailable or inconclusive → the default route with the substitution
#     logged (exit 0). A substitution never adds a reviewer, never changes the
#     budget, the cap or the retry rule.
#   - The DEFAULT route checks the effective configured model with the same
#     cached catalog/access probe. Failure (including transient or missing
#     config/auth/CLI) stops with the model and CLI version, without substitution.
#   - Named-model fallback behavior is unchanged.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cmd="${1:-}"; shift || true
[ "$cmd" = "resolve" ] || { echo "usage: gstack-codex-model resolve --model <slug|\"\"> --effort <medium|high> [--source policy|default] | resolve --voice <purpose> [--effort <low|medium|high>]" >&2; exit 1; }
MODEL=""; EFFORT=""; SOURCE=""; VOICE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --model) MODEL="${2:-}"; shift 2 ;;
    --effort) EFFORT="${2:-}"; shift 2 ;;
    --source) SOURCE="${2:-}"; shift 2 ;;
    --voice) VOICE="${2:-}"; shift 2 ;;
    *) echo "gstack-codex-model: unknown argument $1" >&2; exit 1 ;;
  esac
done
if [ -n "$VOICE" ]; then
  case "$VOICE" in
    *[!A-Za-z0-9._-]*|'') echo "gstack-codex-model: malformed voice '$VOICE'" >&2; exit 1 ;;
  esac
  [ -n "$EFFORT" ] || EFFORT="medium"
  _POLICY_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  if [ -f "$_POLICY_ROOT/.gstack-policy.json" ]; then
    _VOICE_ROUTE=$(bun -e 'try { const p = JSON.parse(await Bun.file(process.argv[1]).text()); const v = p?.routing?.models?.["outside-voice"]?.[process.argv[2]]; if (v && typeof v === "object") process.stdout.write(`${typeof v.model === "string" ? v.model : ""}\t${typeof v.effort === "string" ? v.effort : ""}`); else if (typeof v === "string") process.stdout.write(`${v}\t`); } catch {}' "$_POLICY_ROOT/.gstack-policy.json" "$VOICE" 2>/dev/null || true)
    _VOICE_MODEL="${_VOICE_ROUTE%%	*}"
    _VOICE_EFFORT="${_VOICE_ROUTE#*	}"
    if [ -n "$_VOICE_MODEL" ]; then MODEL="$_VOICE_MODEL"; SOURCE="policy"; fi
    if [ -n "$_VOICE_EFFORT" ]; then EFFORT="$_VOICE_EFFORT"; fi
  fi
  if [ -z "$MODEL" ] && [ -n "${GSTACK_CODEX_MODEL:-}" ]; then MODEL="$GSTACK_CODEX_MODEL"; SOURCE="env"; fi
fi
case "$EFFORT" in
  low|medium|high) ;;
  xhigh|max|ultra) echo "gstack-codex-model: effort '$EFFORT' is never selected automatically; pass it only through an explicit, recorded user override" >&2; exit 1 ;;
  *) echo "gstack-codex-model: --effort must be low|medium|high (got '${EFFORT}')" >&2; exit 1 ;;
esac
# Same anchored shape as gstack-review-budget.ts: first character alphanumeric,
# so a leading-dash value can never reach `codex` as a flag even when this bin
# is called directly rather than from a validated plan (ship security review,
# 2026-09-04); at most 64 characters.
case "$MODEL" in
  ''|default) MODEL="" ;;
  *[!A-Za-z0-9._-]*|[!A-Za-z0-9]*) echo "gstack-codex-model: malformed model slug '$MODEL'" >&2; exit 1 ;;
esac
if [ -n "$MODEL" ] && [ "${#MODEL}" -gt 64 ]; then echo "gstack-codex-model: model slug too long" >&2; exit 1; fi

# Resolve only the config layers this invocation uses: no --profile or -c
# model override is passed on the default route. Project layers load only in
# a trusted project, from root to cwd (nearest wins). Parse TOML, not grep:
# a model inside an unrelated table is not the client's top-level default.
default_model_name() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  bun -e '
    const fs = require("fs"), path = require("path");
    const read = p => {
      try { return Bun.TOML.parse(fs.readFileSync(p, "utf8")); }
      catch (e) { if (e.code === "ENOENT") return {}; throw new Error("Could not parse/read Codex config: " + p); }
    };
    const rawRoot = process.argv[1], root = fs.realpathSync(rawRoot), cwd = fs.realpathSync(process.cwd());
    const user = read(path.join(process.argv[2], "config.toml"));
    let model = user.model;
    const projects = Object.entries(user.projects ?? {}).filter(([p]) => {
      try { return fs.realpathSync(p) === root; } catch { return false; }
    });
    if (projects.some(([,v]) => v?.trust_level === "trusted")) {
      const dirs = [root];
      const rel = path.relative(root, cwd);
      if (rel && !rel.startsWith("..") && !path.isAbsolute(rel))
        for (const part of rel.split(path.sep)) dirs.push(path.join(dirs.at(-1), part));
      for (const dir of dirs) {
        const c = read(path.join(dir, ".codex", "config.toml"));
        if (Object.hasOwn(c, "model")) model = c.model;
      }
    }
    if (model === undefined) process.stdout.write("client-default");
    else if (typeof model !== "string" || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(model))
      throw new Error("Codex default model must be a valid model slug");
    else process.stdout.write(model);
  ' "$root" "${CODEX_HOME:-$HOME/.codex}"
}

emit() {
  # $1 requested $2 used $3 source $4 substituted $5 reason $6 exec_flags $7 review_flags
  # Every value is single-quoted (single quotes stripped from free text) so
  # the caller can `eval` the output verbatim.
  local q
  q() { printf "%s" "$1" | tr -d "'"; }
  printf "CODEX_MODEL_REQUESTED='%s'\n" "$(q "$1")"
  printf "CODEX_MODEL='%s'\n" "$(q "$2")"
  printf "CODEX_MODEL_SOURCE='%s'\n" "$(q "$3")"
  printf "CODEX_MODEL_SUBSTITUTED='%s'\n" "$(q "$4")"
  printf "CODEX_MODEL_SUBSTITUTION_REASON='%s'\n" "$(q "$5")"
  printf "CODEX_MODEL_EXEC_FLAGS='%s'\n" "$(q "$6")"
  printf "CODEX_MODEL_REVIEW_FLAGS='%s'\n" "$(q "$7")"
  printf "CODEX_EFFORT='%s'\n" "$(q "$EFFORT")"
  printf "CODEX_VOICE='%s'\n" "$(q "$VOICE")"
}

# shellcheck disable=SC1091
source "$SCRIPT_DIR/gstack-codex-probe" 2>/dev/null || true
_TEL=$("$SCRIPT_DIR/gstack-config" get telemetry 2>/dev/null || echo off)
DEFAULT_NAME=$(default_model_name) || { echo "Codex default model resolution failed; repair project/user config before retrying." >&2; exit 1; }
if [ -z "$MODEL" ]; then
  CLI_VERSION=$(codex --version 2>/dev/null | head -1)
  CLI_VERSION="${CLI_VERSION:-unavailable}"
  default_error() {
    echo "Codex default model '$DEFAULT_NAME' unavailable or unverified (codex --version: $CLI_VERSION): $1. No model substituted." >&2
    _gstack_codex_log_event "codex_default_model_unavailable" 2>/dev/null || true
    exit 1
  }
  [ "$DEFAULT_NAME" != client-default ] || default_error "no top-level model configured in project/user config.toml"
  command -v codex >/dev/null 2>&1 && _gstack_codex_auth_probe >/dev/null 2>&1 || default_error "no runnable, authenticated Codex CLI"
  DEFAULT_AVAIL=$(_gstack_codex_model_available "$DEFAULT_NAME" 2>/dev/null)
  DEFAULT_RC=$?
  if [ "$DEFAULT_RC" -ne 0 ]; then
    DEFAULT_HINT=$(printf '%s\n' "$DEFAULT_AVAIL" | grep '^HINT: ' | head -1 | sed 's/^HINT: //' | tr -d '\n' | tr '\"$`\\' '    ' | cut -c1-200)
    default_error "${DEFAULT_HINT:-$(printf '%s' "$DEFAULT_AVAIL" | head -1)}"
  fi
  _gstack_codex_log_event "codex_default_model_available" 2>/dev/null || true
  emit "default" "$DEFAULT_NAME" "${SOURCE:-default}" "false" "none" "" ""
  exit 0
fi

if ! command -v codex >/dev/null 2>&1 || ! _gstack_codex_auth_probe >/dev/null 2>&1; then
  emit "$MODEL" "$DEFAULT_NAME" "fallback" "true" "no-auth" "" ""
  echo "Codex model: $MODEL requested but no runnable, authenticated Codex CLI was found; keeping the default route ($DEFAULT_NAME)." >&2
  exit 0
fi
AVAIL_OUT=$(_gstack_codex_model_available "$MODEL" 2>/dev/null)
AVAIL_RC=$?
if [ "$AVAIL_RC" -eq 0 ]; then
  emit "$MODEL" "$MODEL" "${SOURCE:-policy}" "false" "none" "--model $MODEL" "-c model=\"$MODEL\" -c review_model=\"$MODEL\""
  exit 0
fi
HINT=$(printf '%s\n' "$AVAIL_OUT" | grep '^HINT: ' | head -1 | sed 's/^HINT: //' | tr -d '\n' | tr '"$`\\' '    ' | cut -c1-200)
if [ "$AVAIL_RC" -eq 1 ]; then
  REASON="model-unavailable:${HINT:-deterministic model rejection}"
else
  REASON="probe-inconclusive:$(printf '%s' "$AVAIL_OUT" | head -1 | tr -d '\n' | tr '"$`\\' '    ' | cut -c1-120)"
fi
emit "$MODEL" "$DEFAULT_NAME" "fallback" "true" "$REASON" "" ""
echo "Codex model: $MODEL unavailable ($REASON); keeping the default route ($DEFAULT_NAME). Logged as a substitution; budgets, cap and retry rule unchanged." >&2
_gstack_codex_log_event "codex_model_substituted" 2>/dev/null || true
exit 0
