#!/usr/bin/env -S bun --no-env-file --config=/dev/null
// Compatibility adapter into upstream's single brief renderer and dispatch ledger.
import * as path from 'node:path';
import { runScriptSync } from '../lib/script-invocation';
import { governorProject, loadGovernorContext } from '../lib/review-governor-packet';
import { spawnSync } from 'node:child_process';
const [id, base, ...rest] = process.argv.slice(2);
const binDir = path.dirname(Bun.fileURLToPath(import.meta.url));
if (!id || !base) { console.error('gstack-review-context: run id and base required'); process.exitCode = 2; }
else {
  try {
    const root = process.cwd();
    const { project } = governorProject(root, binDir);
    const merge = [`origin/${base}`, base].map(ref => spawnSync('git', ['merge-base', ref, 'HEAD'], { cwd: root, encoding: 'utf8', timeout: 15_000 })).find(r => r.status === 0)?.stdout.trim();
    if (!merge) throw new Error('unable to resolve merge base');
    const out = path.join(project, 'packets', id);
    const r = runScriptSync(path.join(binDir, 'gstack-review-dispatch'), ['render', '--role', 'codex-structured', '--out', out, '--diff-base', merge, '--run-id', id, ...rest], { cwd: root, encoding: 'utf8', timeout: 120_000 });
    process.stdout.write(r.stdout ?? ''); process.stderr.write(r.stderr ?? '');
    process.exitCode = r.status ?? 1;
    if (r.status === 0) {
      const file = path.join(out, 'codex-structured.prompt.md');
      const ctx = loadGovernorContext(root, binDir, id);
      console.log(`PACKET_PATH=${file}\nPACKET_PATHS=${JSON.stringify([{file, out: path.join(out, 'codex-structured.out'), read: 'whole brief'}])}\nDIFF_PATH=${file}\nCI_GREEN=${ctx.ci}`);
    }
  } catch (e) { console.error(`gstack-review-context: ${(e as Error).message}`); process.exitCode = 1; }
}
