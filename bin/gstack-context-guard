#!/usr/bin/env bash
# gstack-context-guard — fast Claude Code PostToolUse context threshold hook
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval "$("$SCRIPT_DIR/gstack-paths")" || exit 1; : "${GSTACK_STATE_ROOT:?gstack-paths failed; reinstall with ./setup or /gstack-upgrade}"
bun "$SCRIPT_DIR/gstack-context-guard.ts"
exit 0
