#!/usr/bin/env bash
# gstack-context-resume — Claude Code SessionStart hook (compact|resume):
# inject the newest checkpoint head so continuity survives auto-compaction.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval "$("$SCRIPT_DIR/gstack-paths")" || exit 1; : "${GSTACK_STATE_ROOT:?gstack-paths failed; reinstall with ./setup or /gstack-upgrade}"
bun "$SCRIPT_DIR/gstack-context-resume.ts"
exit 0
