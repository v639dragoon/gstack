#!/usr/bin/env bash
# gstack-outcome — branch-scoped outcome metadata for review routing
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
GSTACK_HOME="${GSTACK_HOME:-${GSTACK_STATE_DIR:-$HOME/.gstack}}"
eval "$(GSTACK_HOME="$GSTACK_HOME" "$SCRIPT_DIR/gstack-slug" 2>/dev/null)" || exit 1
GSTACK_OUTCOME_PROJECT_DIR="$GSTACK_HOME/projects/$SLUG" \
GSTACK_OUTCOME_BRANCH="$(git branch --show-current 2>/dev/null || printf '%s' "$BRANCH")" bun "$SCRIPT_DIR/gstack-outcome.ts" "$@"
